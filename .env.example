# Copy this file to .env and fill in your values
# The app loads .env automatically via python-dotenv

# ── Generation backend ────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Vector store: "faiss" (default) or "chroma" ───────────────────────────────
# After changing this, run `python -m scripts.reindex` to populate the new
# backend from data/chunk_store.json.
VECTOR_STORE_BACKEND=faiss

# ── Chroma Cloud (optional) ───────────────────────────────────────────────────
# Setting CHROMA_API_KEY switches the chroma backend from a local on-disk client
# to the managed service. Tenant and database are required alongside the key.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# ── Model overrides (optional — defaults shown) ───────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# GEMINI_MODEL=gemini-3.6-flash

# ── Retrieval hyperparameters (optional) ──────────────────────────────────────
# VECTOR_TOP_K=10
# BM25_TOP_K=10
# FINAL_TOP_N=5

# ── Confidence + abstention thresholds ────────────────────────────────────────
# RAW cross-encoder logits (roughly -11..+11), NOT probabilities. A sigmoid
# squashes irrelevant passages to ~0.00002 and good ones to ~0.9997, so every
# decision boundary would fall inside a rounding error.
#
# These are corpus-specific. Measure with `python -m scripts.calibrate` after
# ingesting; do not carry values between corpora. The script reports whether
# answerable and unanswerable questions separate cleanly, and refuses to invent
# a number when they overlap.
#
# Getting the floor wrong breaks things in opposite directions: too high and
# answerable questions abstain, too low and a question about a company that was
# never indexed produces a figure.
# RERANK_HIGH_THRESHOLD=2.0
# RERANK_MODERATE_THRESHOLD=-2.0
# RERANK_ABSTAIN_THRESHOLD=-6.0
#
# Supporting chunks at or above the moderate threshold required for "high".
# One strong match is a single point of failure; agreement is what earns it.
# CONFIDENCE_MIN_SUPPORTING=2

# ── Storage (optional) ────────────────────────────────────────────────────────
# Where ingested PDFs are kept so citations can open their source page.
# Deliberately not pdf_data/, which is the operator's source corpus.
# PDF_STORE_DIR=data/pdf_store
